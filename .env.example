# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role (server-side only, never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Jenkins =====
JENKINS_BASE_URL=https://jenkins.your-domain.com
JENKINS_USER=your-jenkins-user
JENKINS_API_TOKEN=your-jenkins-api-token

# ===== Jira =====
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER=your-jira-email
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PAP

# Custom field overrides (optional)
# CF_SISTEMA=customfield_12332
# CF_TIPO=customfield_12321
# CF_CALENDARIO_CAMBIOS=customfield_10248
# CF_CONSECUENCIAS=customfield_10182
# CF_PLAN_DESPLIEGUE=customfield_10199
# CF_PLAN_VALIDACION=customfield_10198
# CF_SOLUCION_REQUERIMIENTO=customfield_10300
# CF_RAZON_CAMBIO=customfield_10179
# CF_GRADO_SEVERIDAD=customfield_10059
# CF_ADJUNTAR_RDC_DEPLOYMENT=customfield_10318

# ===== Resend (email) =====
RESEND_API_KEY=re_your-resend-key

# ===== Administration =====
# Comma-separated super admin emails
SUPER_ADMIN_EMAILS=admin@klap.cl

# ===== Optional =====
# NEXT_PUBLIC_WELCOME_EMAILS=email1@klap.cl,email2@klap.cl
